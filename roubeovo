-- ============================================================
--  ESP
-- ============================================================
local hasDrawing = pcall(function() return Drawing.new end)
local Cache = {}

local function mkESP(inst)
    if not hasDrawing then return end
    local d = {}
    d.Box = Drawing.new("Square"); d.Box.Thickness = 1; d.Box.Filled = false; d.Box.Transparency = 1; d.Box.Visible = false
    d.Name = Drawing.new("Text"); d.Name.Size = 13; d.Name.Center = true; d.Name.Outline = true; d.Name.Visible = false
    Cache[inst] = d
end

local function clearESP(inst)
    if Cache[inst] then
        for _, o in pairs(Cache[inst]) do pcall(function() o:Remove() end) end
        Cache[inst] = nil
    end
end

local function w2v(pos)
    local s, _ = Camera:WorldToViewportPoint(pos)
    return Vector2.new(s.X, s.Y)
end

local function drawESP()
    local seen = {}
    local function process(inst, color, label)
        if not inst or not inst.Parent then return end
        local part = inst:IsA("Model") and (inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart")) or (inst:IsA("BasePart") and inst)
        if not part then return end
        seen[inst] = true
        if not Cache[inst] then mkESP(inst) end
        local e = Cache[inst]
        local pos, on = Camera:WorldToViewportPoint(part.Position)
        if not on then
            e.Box.Visible = false; e.Name.Visible = false
            return
        end
        local size = 40
        e.Box.Size = Vector2.new(size, size)
        e.Box.Position = Vector2.new(pos.X - size/2, pos.Y - size/2)
        e.Box.Color = color
        e.Box.Visible = true
        e.Name.Text = label
        e.Name.Position = Vector2.new(pos.X, pos.Y - size/2 - 14)
        e.Name.Color = color
        e.Name.Visible = true
    end

    if cfg.espBrainrots then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and (obj.Name:lower():find("brainrot") or obj.Name:lower():find("character")) and not Players:GetPlayerFromCharacter(obj) then
                process(obj, Color3.fromRGB(255, 200, 100), obj.Name)
            end
        end
    end

    if cfg.espPlayers then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                process(p.Character, Color3.fromRGB(255, 100, 100), p.Name)
            end
        end
    end

    if cfg.espEggs then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and obj.Name:lower():find("egg") then
                process(obj, Color3.fromRGB(100, 220, 255), obj.Name)
            end
        end
    end

    for inst, _ in pairs(Cache) do
        if not seen[inst] then clearESP(inst) end
    end
end

RunService.RenderStepped:Connect(drawESP)

-- ============================================================
--  AUTO COLLECT / AUTO STEAL
-- ============================================================
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if cfg.autoCollect then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and (obj.Name:lower():find("collect") or obj.Name:lower():find("pickup")) then
                pcall(function()
                    firetouchinterest(hrp, obj, 0)
                    firetouchinterest(hrp, obj, 1)
                end)
            end
        end
    end

    if cfg.teleportToEgg then
        local nearest, dist = nil, math.huge
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Model") and obj.Name:lower():find("egg") and obj.PrimaryPart then
                local d = (obj.PrimaryPart.Position - hrp.Position).Magnitude
                if d < dist then dist = d; nearest = obj end
            end
        end
        if nearest and nearest.PrimaryPart then
            hrp.CFrame = CFrame.new(nearest.PrimaryPart.Position + Vector3.new(0, 5, 0))
        end
    end
end)

