--  ESP leve com scan de 2 em 2 segundos
-- ============================================================
local hasDrawing = pcall(function() return Drawing.new end)
local Cache = {}
local eggsList = {}
local playerList = {}

local function ensureEntry(inst)
    if not Cache[inst] then
        local box = Drawing.new("Square")
        box.Thickness = 1
        box.Filled = false
        box.Transparency = 1
        box.Visible = false
        local lbl = Drawing.new("Text")
        lbl.Size = 13
        lbl.Center = true
        lbl.Outline = true
        lbl.Visible = false
        Cache[inst] = { box = box, lbl = lbl }
    end
    return Cache[inst]
end

local function removeEntry(inst)
    if Cache[inst] then
        pcall(function() Cache[inst].box:Remove() end)
        pcall(function() Cache[inst].lbl:Remove() end)
        Cache[inst] = nil
    end
end

-- Scan em background
task.spawn(function()
    while SG.Parent do
        local eggs = {}
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj:IsA("Model") then
                local n = obj.Name:lower()
                if n:find("egg") or n:find("brainrot") then
                    eggs[#eggs + 1] = obj
                end
            end
        end
        eggsList = eggs

        local pls = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                pls[#pls + 1] = p.Character
            end
        end
        playerList = pls

        task.wait(2)
    end
end)

local function drawList(list, enabled, color)
    if not hasDrawing then return end
    for _, inst in ipairs(list) do
        if not inst.Parent then
            removeEntry(inst)
        elseif enabled then
            local part = inst:IsA("Model") and (inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart")) or inst
            if part then
                local pos, on = Cam:WorldToViewportPoint(part.Position)
                local e = ensureEntry(inst)
                if on then
                    local size = 40
                    e.box.Size = Vector2.new(size, size)
                    e.box.Position = Vector2.new(pos.X - size / 2, pos.Y - size / 2)
                    e.box.Color = color
                    e.box.Visible = true
                    e.lbl.Text = inst.Name
                    e.lbl.Position = Vector2.new(pos.X, pos.Y - size / 2 - 14)
                    e.lbl.Color = color
                    e.lbl.Visible = true
                else
                    e.box.Visible = false
                    e.lbl.Visible = false
                end
            end
        else
            local e = Cache[inst]
            if e then
                e.box.Visible = false
                e.lbl.Visible = false
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    drawList(eggsList, cfg.espEggs, Color3.fromRGB(100, 220, 255))
    drawList(playerList, cfg.espPlayers, Color3.fromRGB(255, 100, 100))
end)

-- ============================================================
--  AUTO COLLECT — usa ProximityPrompt (interação)
-- ============================================================
task.spawn(function()
    local fired = {}
    while SG.Parent do
        if cfg.autoCollect then
            local char = LP.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                for _, egg in ipairs(eggsList) do
                    local part = egg:IsA("Model") and (egg.PrimaryPart or egg:FindFirstChildWhichIsA("BasePart")) or egg
                    if part then
                        local d = (part.Position - hrp.Position).Magnitude
                        if d < cfg.collectRadius then
                            -- acha ProximityPrompt dentro do egg e dispara UMA vez
                            for _, desc in ipairs(egg:GetDescendants()) do
                                if desc:IsA("ProximityPrompt") and desc.Enabled then
                                    local key = egg
                                    if not fired[key] then
                                        fired[key] = true
                                        pcall(function() fireproximityprompt(desc) end)
                                        task.delay(1, function() fired[key] = nil end)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        else
            fired = {}
        end
        task.wait(0.2)
    end
end)
